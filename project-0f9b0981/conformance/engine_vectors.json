{
  "_about": "Golden test vectors for the ORION Engine orchestration rules. Every row is checked by Lean in RequestProject/Conformance/EngineVectors.lean.",
  "phases": ["define", "retrieve", "evaluate", "connect", "generate", "attack", "refine", "human_review", "test", "record", "reuse"],
  "step": {
    "_rule": "a move p -> q is permitted iff index(q) = index(p) + 1 (advance one phase) or index(q) < index(p) (bounce back)",
    "cases": [
      {"from": "attack", "to": "generate", "expected": true},
      {"from": "reuse", "to": "define", "expected": true},
      {"from": "human_review", "to": "test", "expected": true},
      {"from": "define", "to": "evaluate", "expected": false},
      {"from": "refine", "to": "test", "expected": false},
      {"from": "generate", "to": "human_review", "expected": false}
    ]
  },
  "stops": {
    "_rule": "reasons = [evidence if not enough_evidence] + [safety if not acceptable_risk] + [authority if not authorized]; proceed iff reasons is empty",
    "cases": [
      {"enough_evidence": true, "acceptable_risk": true, "authorized": true, "expected": []},
      {"enough_evidence": false, "acceptable_risk": true, "authorized": true, "expected": ["evidence"]},
      {"enough_evidence": true, "acceptable_risk": false, "authorized": false, "expected": ["safety", "authority"]},
      {"enough_evidence": false, "acceptable_risk": false, "authorized": false, "expected": ["evidence", "safety", "authority"]}
    ]
  },
  "resume": {
    "_rule": "can_resume = (actor == operator) and no stop reasons",
    "cases": [
      {"actor": "user", "enough_evidence": true, "acceptable_risk": true, "authorized": true, "expected": false},
      {"actor": "operator", "enough_evidence": true, "acceptable_risk": true, "authorized": true, "expected": true},
      {"actor": "operator", "enough_evidence": true, "acceptable_risk": false, "authorized": true, "expected": false}
    ]
  },
  "ladder": {
    "_rule": "level = min(8, floor(sum(turn risks) / step)); rungs 0..8 = assist, clarify, name_harm, refuse_operational, offer_alternatives, deescalate, harm_reduction, escalate, end_interaction",
    "step": 10,
    "cases": [
      {"turns": [], "expected": 0},
      {"turns": [3, 4], "expected": 0},
      {"turns": [9, 1], "expected": 1},
      {"turns": [25], "expected": 2},
      {"turns": [5, 5, 5, 5, 5], "expected": 2},
      {"turns": [30, 30, 30], "expected": 8}
    ]
  },
  "debate": {
    "_rule": "run rounds 0..limit-1; return the first converging round, or 'escalate_to_catalyst' if none converges",
    "cases": [
      {"limit": 5, "converging_rounds": [3, 4], "expected": 3},
      {"limit": 5, "converging_rounds": [], "expected": "escalate_to_catalyst"},
      {"limit": 3, "converging_rounds": [3], "expected": "escalate_to_catalyst"}
    ]
  },
  "ledger_guard": {
    "_rule": "accept a proposed ledger iff the current ledger is a prefix of it; otherwise hard stop (null)",
    "cases": [
      {"current": [1, 2], "proposed": [1, 2, 3], "expected": [1, 2, 3]},
      {"current": [1, 2], "proposed": [1, 5], "expected": null},
      {"current": [1, 2], "proposed": [1], "expected": null}
    ]
  }
}
