--- cmpA/lean-workers-union-v0.3/LeanWorkersUnion/Preservation.lean	1970-01-01 00:00:00.000000000 +0000
+++ cmpB/lean-workers-union-v0.3/LeanWorkersUnion/Preservation.lean	2026-10-03 18:21:19.574600979 +0000
@@ -0,0 +1,59 @@
+import LeanWorkersUnion.Invariants
+import LeanWorkersUnion.Registry
+
+namespace ChoirUnion
+
+/-- The derived `==` on member ids agrees with equality. -/
+theorem memberId_beq_iff (a b : MemberId) : (a == b) = true ↔ a = b := by
+  cases a; cases b
+  constructor
+  · intro h
+    have : _ := h
+    simp_all [BEq.beq, instBEqMemberId.beq]
+  · intro h; cases h
+    simp [BEq.beq, instBEqMemberId.beq]
+
+/-- `memberIdTaken` is exactly membership of the id in the registry's id list. -/
+theorem memberIdTaken_iff (reg : UnionRegistry) (mid : MemberId) :
+    memberIdTaken reg mid = true ↔ mid ∈ registryMemberIds reg := by
+  simp [memberIdTaken, registryMemberIds, memberId_beq_iff]
+
+/-- **Successful registration preserves unique member ids.** -/
+theorem registrationPreservesUnique
+    (reg reg' : UnionRegistry) (entry : UnionMembership)
+    (hu : UniqueMemberIds reg) (h : registerMember reg entry = .ok reg') :
+    UniqueMemberIds reg' := by
+  unfold registerMember at h
+  split at h
+  · simp at h
+  · rename_i hfree
+    cases h
+    have hnot : entry.state.identity.memberId ∉ registryMemberIds reg := by
+      intro hm; rw [← memberIdTaken_iff] at hm; simp_all
+    simpa [UniqueMemberIds, registryMemberIds] using
+      (List.nodup_cons.2 ⟨hnot, hu⟩ : (entry.state.identity.memberId :: registryMemberIds reg).Nodup)
+
+/-- **Cursor discovery reconstructs the original registry.** -/
+theorem findCursor_reconstructs (reg : UnionRegistry) (target : MemberId) (c : RegistryCursor)
+    (h : findCursorByMemberId reg target = some c) :
+    c.toRegistry = reg ∧ c.focus.state.identity.memberId = target := by
+  suffices key : ∀ (pre rest : List UnionMembership) (c : RegistryCursor),
+      findCursorByMemberId.go target pre rest = some c →
+      c.pfx ++ c.focus :: c.suffix = pre.reverse ++ rest ∧
+        c.focus.state.identity.memberId = target by
+    obtain ⟨h1, h2⟩ := key [] reg.members c h
+    exact ⟨by cases reg; simp_all [RegistryCursor.toRegistry], h2⟩
+  intro pre rest
+  induction rest generalizing pre with
+  | nil => intro c h; simp [findCursorByMemberId.go] at h
+  | cons m tail ih =>
+    intro c h
+    simp only [findCursorByMemberId.go] at h
+    split at h
+    · rename_i hm
+      cases h
+      exact ⟨rfl, (memberId_beq_iff _ _).1 hm⟩
+    · obtain ⟨h1, h2⟩ := ih (m :: pre) c h
+      exact ⟨by simpa using h1, h2⟩
+
+end ChoirUnion
